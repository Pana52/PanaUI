{
  "name": "panaui",
  "version": "0.0.1",
  "license": "MIT",
  "type": "module",
  "files": [
    "dist"
  ],
  "main": "./dist/panaui.umd.cjs",
  "module": "./dist/panaui.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/panaui.js",
      "require": "./dist/panaui.umd.cjs"
    },
    "./styles": "./dist/style.css"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "vite build && tsc --emitDeclarationOnly --project tsconfig.json",
    "dev": "vite build --watch"
  },
  "peerDependencies": {
    "react": ">=18.0.0",
    "react-dom": ">=18.0.0"
  },
  "devDependencies": {
    "@types/node": "^25.9.1",
    "@storybook/react": "^8.6.18"
  },
  "dependencies": {
    "@panaui/tokens": "workspace:*"
  }
}
