{
  "name": "panaui",
  "version": "0.0.1",
  "license": "MIT",
  "type": "module",
  "files": [
    "dist"
  ],
  "main": "./dist/panaui.umd.cjs",
  "module": "./dist/panaui.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/panaui.js",
      "require": "./dist/panaui.umd.cjs"
    },
    "./styles": {
      "types": "./dist/style.css.d.ts",
      "default": "./dist/panaui.css"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "vite build && tsc --emitDeclarationOnly --project tsconfig.json && node -p \"require('fs').copyFileSync('src/style.css.d.ts', 'dist/style.css.d.ts')\"",
    "dev": "vite build --watch"
  },
  "peerDependencies": {
    "react": ">=18.0.0",
    "react-dom": ">=18.0.0"
  },
  "devDependencies": {
    "@types/node": "^25.9.1",
    "@storybook/react": "^8.6.18"
  },
  "dependencies": {
    "@panaui/tokens": "workspace:*",
    "class-variance-authority": "^0.7.1",
    "tailwind-merge": "^3.3.0"
  }
}
